<ContentPage
    x:Class="MyJellyfinClient.Views.MediaDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Details"
    BackgroundColor="#10141D">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="{Binding MediaTitle}"
                TextColor="White" />

            <!--  Uebersichtliche Infos: Chips (Laenge, Qualitaet, Groesse, Sprachen ...)  -->
            <VerticalStackLayout Spacing="12">
                <FlexLayout
                    AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding InfoChips}"
                    Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,8,8"
                                Padding="10,5"
                                BackgroundColor="#1B2230"
                                Stroke="#2D323E"
                                StrokeShape="RoundRectangle 14">
                                <Label
                                    FontSize="12"
                                    Text="{Binding .}"
                                    TextColor="#D0D4DC" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label
                    FontSize="12"
                    IsVisible="{Binding HasGenres}"
                    Text="{Binding GenresText}"
                    TextColor="#00A4DC" />

                <!--  Beschreibung: 4 Zeilen, Tippen klappt auf/zu  -->
                <Label
                    FontSize="14"
                    IsVisible="{Binding HasOverview}"
                    LineBreakMode="TailTruncation"
                    MaxLines="{Binding OverviewMaxLines}"
                    Text="{Binding Overview}"
                    TextColor="#A0A0A0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleOverviewCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Border
                Padding="15"
                BackgroundColor="#1B2230"
                StrokeShape="RoundRectangle 10">                <VerticalStackLayout Spacing="15">
                    <Label
                        FontAttributes="Bold"
                        Text="Offline bereitstellen"
                        TextColor="White" />

                    <Label
                        FontSize="14"
                        Text="Qualität auswählen:"
                        TextColor="#A0A0A0" />
                    <Picker
                        Title="Qualität wählen"
                        BackgroundColor="#2D323E"
                        ItemsSource="{Binding AvailableQualities}"
                        SelectedItem="{Binding SelectedQuality}"
                        TextColor="White" />

                    <Label
                        FontSize="14"
                        Text="Tonspur:"
                        TextColor="#A0A0A0" />
                    <Picker
                        Title="Tonspur wählen"
                        BackgroundColor="#2D323E"
                        ItemsSource="{Binding AudioTracks}"
                        SelectedItem="{Binding SelectedAudio}"
                        TextColor="White" />

                    <Label
                        FontSize="14"
                        Text="Untertitel:"
                        TextColor="#A0A0A0" />
                    <Picker
                        Title="Untertitel wählen"
                        BackgroundColor="#2D323E"
                        ItemsSource="{Binding SubtitleTracks}"
                        SelectedItem="{Binding SelectedSubtitle}"
                        TextColor="White" />

                    <!--  Der Button ruft das StartDownloadAsync Command im ViewModel auf  -->
                    <Button
                        BackgroundColor="#AA5CC3"
                        Command="{Binding StartDownloadCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        Text="Herunterladen"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
