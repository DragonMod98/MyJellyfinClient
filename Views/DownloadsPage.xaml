<ContentPage
    x:Class="MyJellyfinClient.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meine Downloads"
    BackgroundColor="#10141D">

    <Grid RowDefinitions="Auto,*">
        <!--  Header (Speicherplatz Übersicht)  -->
        <Border
            Grid.Row="0"
            Margin="15"
            Padding="15"
            BackgroundColor="#1B2230"
            StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Lokaler Speicher"
                    TextColor="White" />
                <!--  Hier kann später das Binding für FileSizeBytes aus der Datenbank rein  -->
                <ProgressBar
                    HeightRequest="8"
                    Progress="0.45"
                    ProgressColor="#AA5CC3" />
                <Label
                    FontSize="12"
                    Text="12.4 GB belegt"
                    TextColor="#A0A0A0" />
            </VerticalStackLayout>
        </Border>

        <!--  Liste der heruntergeladenen Filme/Serien  -->
        <CollectionView
            Grid.Row="1"
            Margin="15,0"
            ItemsSource="{Binding DownloadedItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Margin="0,0,0,15"
                        ColumnDefinitions="100,*"
                        RowDefinitions="Auto,Auto">
                        <!--  Platzhalter für Film-Poster (Lokal gespeichert)  -->
                        <Frame
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="#2D323E"
                            CornerRadius="8"
                            HasShadow="False"
                            HeightRequest="150">
                            <Image Aspect="AspectFill" Source="{Binding LocalPosterPath}" />
                        </Frame>

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="15,0,0,0"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Title}"
                                TextColor="White" />
                            <Label
                                FontSize="14"
                                IsVisible="{Binding IsSeries}"
                                Text="{Binding SeriesName}"
                                TextColor="#00A4DC" />

                            <!--  Offline Status Indikator  -->
                            <HorizontalStackLayout Margin="0,10,0,0" Spacing="5">
                                <Image
                                    HeightRequest="16"
                                    Source="download_done.png"
                                    WidthRequest="16" />
                                <Label
                                    FontSize="12"
                                    Text="Lokal verfügbar"
                                    TextColor="#E5A00D" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>