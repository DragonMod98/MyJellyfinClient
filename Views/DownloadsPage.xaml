<ContentPage
    x:Class="MyJellyfinClient.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meine Downloads"
    BackgroundColor="#10141D">

    <Grid RowDefinitions="Auto,*">
        <!--  Header (Speicherplatz Übersicht)  -->
        <Border
            Grid.Row="0"
            Margin="15"
            Padding="15"
            BackgroundColor="{StaticResource SurfaceBackground}"
            StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Lokaler Speicher"
                    TextColor="{StaticResource TextColorPrimary}" />
                <ProgressBar
                    HeightRequest="8"
                    Progress="{Binding StorageProgress}"
                    ProgressColor="{StaticResource Primary}" />
                <Label
                    FontSize="12"
                    Text="{Binding StorageUsageText}"
                    TextColor="{StaticResource TextColorSecondary}" />
            </VerticalStackLayout>
        </Border>

        <!--  Liste der heruntergeladenen Filme/Serien, gruppiert nach Serie (einklappbar)  -->
        <CollectionView
            Grid.Row="1"
            Margin="15,0"
            IsGrouped="True"
            ItemsSource="{Binding DownloadGroups}">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        BackgroundColor="#1B2230"
                        StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleGroupCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="30,*" RowDefinitions="Auto,Auto,Auto">
                            <Label
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                FontSize="16"
                                Text="{Binding ExpandIcon}"
                                TextColor="#00A4DC"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}"
                                TextColor="White" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="12"
                                Text="{Binding Subtitle}"
                                TextColor="{StaticResource TextColorSecondary}" />
                            <ProgressBar
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                HeightRequest="4"
                                Progress="{Binding Progress}"
                                ProgressColor="{StaticResource Primary}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Margin="12,0,0,10"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayOfflineCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!--  Titel (bei Serien: Folge)  -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Title}"
                            TextColor="White" />

                        <!--  Serie / Staffel  -->
                        <Label
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            FontSize="12"
                            IsVisible="{Binding IsSeries}"
                            LineBreakMode="TailTruncation"
                            Text="{Binding SeasonName}"
                            TextColor="#00A4DC" />

                        <!--  Fortschrittsbalken: wie weit wurde es schon gesehen  -->
                        <ProgressBar
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            HeightRequest="6"
                            Progress="{Binding Progress}"
                            ProgressColor="#E5A00D" />
                        <Label
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            FontSize="11"
                            Text="{Binding ProgressText}"
                            TextColor="{StaticResource TextColorSecondary}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
