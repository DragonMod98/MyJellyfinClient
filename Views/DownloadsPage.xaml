<ContentPage
    x:Class="MyJellyfinClient.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meine Downloads"
    BackgroundColor="#10141D">

    <Grid RowDefinitions="Auto,Auto,*">
        <!--  Header (Speicherplatz Übersicht)  -->
        <Border
            Grid.Row="0"
            Margin="15"
            Padding="15"
            BackgroundColor="{StaticResource SurfaceBackground}"
            StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Lokaler Speicher"
                    TextColor="{StaticResource TextColorPrimary}" />
                <ProgressBar
                    HeightRequest="8"
                    Progress="{Binding StorageProgress}"
                    ProgressColor="{StaticResource Primary}" />
                <Label
                    FontSize="12"
                    Text="{Binding StorageUsageText}"
                    TextColor="{StaticResource TextColorSecondary}" />
            </VerticalStackLayout>
        </Border>

        <!--  Laufende/wartende Downloads mit Fortschritt und Abbrechen  -->
        <Border
            Grid.Row="1"
            Margin="15,0,15,10"
            Padding="12"
            BackgroundColor="#1B2230"
            IsVisible="{Binding HasActiveDownloads}"
            StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Aktive Downloads"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        Command="{Binding CancelAllDownloadsCommand}"
                        FontSize="12"
                        Padding="8,0"
                        Text="Alle abbrechen"
                        TextColor="#E57373" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActiveDownloads}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Title}"
                                    TextColor="White" />
                                <Button
                                    Grid.RowSpan="3"
                                    Grid.Column="1"
                                    BackgroundColor="#C0392B"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelDownloadCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="16"
                                    FontAttributes="Bold"
                                    HeightRequest="32"
                                    Margin="10,0,0,0"
                                    Padding="0"
                                    Text="✕"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    WidthRequest="32" />
                                <ProgressBar
                                    Grid.Row="1"
                                    Margin="0,6,0,0"
                                    HeightRequest="6"
                                    Progress="{Binding Progress}"
                                    ProgressColor="{StaticResource Primary}" />
                                <Label
                                    Grid.Row="2"
                                    FontSize="11"
                                    Text="{Binding StatusText}"
                                    TextColor="{StaticResource TextColorSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!--  Liste der heruntergeladenen Filme/Serien, gruppiert nach Serie (einklappbar)  -->
        <CollectionView
            Grid.Row="2"
            Margin="15,0"
            IsGrouped="True"
            ItemsSource="{Binding DownloadGroups}">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <SwipeView Margin="0,0,0,8">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Execute">
                            <SwipeItem BackgroundColor="#C0392B" Text="Löschen" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteGroupCommand}" CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Border
                        Margin="0"
                        Padding="12"
                        BackgroundColor="#1B2230"
                        StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleGroupCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="30,*" RowDefinitions="Auto,Auto,Auto">
                            <Label
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                FontSize="16"
                                Text="{Binding ExpandIcon}"
                                TextColor="#00A4DC"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}"
                                TextColor="White" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="12"
                                Text="{Binding Subtitle}"
                                TextColor="{StaticResource TextColorSecondary}" />
                            <ProgressBar
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                HeightRequest="4"
                                Progress="{Binding Progress}"
                                ProgressColor="{StaticResource Primary}" />
                        </Grid>
                    </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="12,0,0,10" BackgroundColor="#10141D">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem BackgroundColor="#C0392B" Text="Löschen" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}" CommandParameter="{Binding .}" />
                            <SwipeItem BackgroundColor="#8E2C20" Text="Staffel löschen" IsVisible="{Binding IsSeries}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteSeasonCommand}" CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Grid
                        Margin="0"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayOfflineCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!--  Titel (bei Serien: Folge)  -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Title}"
                            TextColor="White" />

                        <!--  Serie / Staffel  -->
                        <Label
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            FontSize="12"
                            IsVisible="{Binding IsSeries}"
                            LineBreakMode="TailTruncation"
                            Text="{Binding SeasonName}"
                            TextColor="#00A4DC" />

                        <!--  Fortschrittsbalken: wie weit wurde es schon gesehen  -->
                        <ProgressBar
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            HeightRequest="6"
                            Progress="{Binding Progress}"
                            ProgressColor="#E5A00D" />
                        <Label
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            FontSize="11"
                            Text="{Binding ProgressText}"
                            TextColor="{StaticResource TextColorSecondary}" />
                    </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>


