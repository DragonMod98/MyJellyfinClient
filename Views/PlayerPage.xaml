<ContentPage
    x:Class="MyJellyfinClient.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False"
    Shell.PresentationMode="Animated"
    Shell.TabBarIsVisible="False">

    <Grid>
        <!--  Die native VLC Engine  -->
        <vlc:MediaPlayerElement
            x:Name="VideoPlayer"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!--  Overlay für die Gestensteuerung (mit Randabstand links/rechts für Android-Zurück-Gesten)  -->
        <Grid x:Name="GestureOverlay" BackgroundColor="Transparent" Margin="40,0,40,140">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  Linke Hälfte: Helligkeit  -->
                <ColumnDefinition Width="*" />
                <!--  Rechte Hälfte: Lautstärke  -->
            </Grid.ColumnDefinitions>

            <ContentView Grid.Column="0" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnLeftDoubleTapped" />
                    <TapGestureRecognizer Tapped="OnScreenTapped" />
                    <PanGestureRecognizer PanUpdated="OnLeftScreenPanUpdated" />
                </ContentView.GestureRecognizers>
            </ContentView>

            <ContentView Grid.Column="1" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnRightDoubleTapped" />
                    <TapGestureRecognizer Tapped="OnScreenTapped" />
                    <PanGestureRecognizer PanUpdated="OnRightScreenPanUpdated" />
                </ContentView.GestureRecognizers>
            </ContentView>
        </Grid>

        <!--  OSD (On Screen Display) für Feedback  -->
        <Border
            x:Name="OsdContainer"
            Padding="20,10"
            BackgroundColor="#80000000"
            HorizontalOptions="Center"
            IsVisible="False"
            StrokeShape="RoundRectangle 10"
            VerticalOptions="Center">
            <Label
                x:Name="OsdText"
                FontAttributes="Bold"
                FontSize="32"
                TextColor="White" />
        </Border>
    </Grid>
</ContentPage>
