<ContentPage
    x:Class="MyJellyfinClient.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="LibraryPageRoot"
    Title="Bibliothek">

    <Grid RowDefinitions="Auto,*">
        <!--  Navigationsleiste im Unterordner: Zurück + (bei Folgen/Videos) Alle herunterladen  -->
        <HorizontalStackLayout
            Grid.Row="0"
            Margin="12,8"
            IsVisible="{Binding IsInSubFolder}"
            Spacing="10">
            <Button
                BackgroundColor="#2A2E3D"
                Command="{Binding GoBackCommand}"
                Text="← Zurück"
                TextColor="White" />
            <Button
                BackgroundColor="#AA5CC3"
                Command="{Binding DownloadFolderCommand}"
                IsVisible="{Binding CanDownloadFolder}"
                Text="⬇ Alle herunterladen"
                TextColor="White" />
        </HorizontalStackLayout>

        <!--  Offline Banner  -->
        <Border
            Grid.Row="1"
            Margin="10"
            Padding="15"
            VerticalOptions="Start"
            BackgroundColor="#E5A00D"
            IsVisible="{Binding IsOfflineMode}"
            StrokeShape="RoundRectangle 8">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Text="Keine Verbindung zum Server"
                    TextColor="Black" />
                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="Du bist im Offline-Modus. Gehe zum Tab 'Downloads', um deine lokal gespeicherten Medien anzusehen."
                    TextColor="Black" />
                <Button
                    Margin="0,10,0,0"
                    BackgroundColor="Black"
                    Command="{Binding LoadLibraryCommand}"
                    HeightRequest="40"
                    Text="Erneut versuchen"
                    TextColor="White" />
            </VerticalStackLayout>
        </Border>

        <!--  Kachel-Ansicht für die Filme (Wird nur angezeigt, wenn IsLoading = false)  -->
        <CollectionView
            Grid.Row="1"
            Margin="10"
            ItemsSource="{Binding LibraryItems}">

            <CollectionView.ItemsLayout>
                <!--  3 Spalten Layout für Film-Poster  -->
                <GridItemsLayout
                    HorizontalItemSpacing="10"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="0"
                        BackgroundColor="{StaticResource SurfaceBackground}"
                        HeightRequest="180">

                        <!--  Klick-Erkennung  -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference LibraryPageRoot}, Path=BindingContext.GoToDetailsCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="*, Auto">
                            <!--  Film Poster laden  -->
                            <Image
                                Grid.Row="0"
                                Aspect="AspectFill"
                                Source="{Binding ImageUrl}" />

                            <!--  Halbtransparenter Titel unten am Poster  -->
                            <Border
                                Grid.Row="1"
                                Padding="5"
                                BackgroundColor="#CC10141D">
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}"
                                    TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!--  Lade-Indikator ganz am Ende = im Vordergrund  -->
        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>