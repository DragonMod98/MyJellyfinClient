<ContentPage
    x:Class="MyJellyfinClient.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="LibraryPageRoot"
    Title="Bibliothek">

    <Grid>
        <!--  Lade-Indikator (Kreis), solange die API arbeitet  -->
        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            Color="{StaticResource Primary}" />

        <!--  Kachel-Ansicht für die Filme (Wird nur angezeigt, wenn IsLoading = false)  -->
        <CollectionView Margin="10" ItemsSource="{Binding LibraryItems}">

            <CollectionView.ItemsLayout>
                <!--  3 Spalten Layout für Film-Poster  -->
                <GridItemsLayout
                    HorizontalItemSpacing="10"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="0"
                        BackgroundColor="{StaticResource SurfaceBackground}"
                        CornerRadius="8"
                        HasShadow="False"
                        HeightRequest="180">

                        <!--  Klick-Erkennung  -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference LibraryPageRoot}, Path=BindingContext.GoToDetailsCommand}" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid RowDefinitions="*, Auto">
                            <!--  Film Poster laden  -->
                            <Image
                                Grid.Row="0"
                                Aspect="AspectFill"
                                Source="{Binding ImageUrl}" />

                            <!--  Halbtransparenter Titel unten am Poster  -->
                            <Border
                                Grid.Row="1"
                                Padding="5"
                                BackgroundColor="#CC10141D">
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}"
                                    TextColor="White" />
                            </Border>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>